# frozen_string_literal: true

module <%= resource_collection_module_name %>
  class UpdateService
    def self.call(<%= singular_name %>:, params:)
      new(<%= singular_name %>:, params:).call
    end

    def initialize(<%= singular_name %>:, params:)
      @<%= singular_name %> = <%= singular_name %>
      @params = params
    end

    def call
      if <%= singular_name %>.update(params)
        return Result.success(
          <%= singular_name %>,
          HttpStatus::OK,
          "<%= resource_human_name %> atualizado com sucesso"
        )
      end

      Result.failure(
        <%= singular_name %>.errors.full_messages,
        HttpStatus::UNPROCESSABLE_ENTITY,
        "Nao foi possivel atualizar <%= resource_human_name.downcase %>"
      )
    end

    private

    attr_reader :<%= singular_name %>, :params
  end
end
