<% primeiro_acesso = @primeiro_acesso.present? ? @primeiro_acesso : @usuario.try(:primeiro_acesso?) %>
<% content_for :email_title, primeiro_acesso ? "Definicao de senha" : "Redefinicao de senha" %>
<% content_for :preheader, primeiro_acesso ? "Sua conta foi criada. Use este email para definir sua senha de acesso." : "Recebemos um pedido para redefinir sua senha na Escola de Musica." %>

<% nome_destinatario = @usuario.try(:g_pessoa).try(:nome).presence || @usuario.try(:email).presence || @resource.try(:email) %>
<% app_nome = @app_nome.presence || "Escola de Musica" %>
<% prazo_texto = @token_validade_label || "algumas horas" %>
<% recuperar_senha_url = @recuperar_senha_url || edit_user_password_url(reset_password_token: @token) %>

<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 24px;">
  <tr>
    <td>
      <span style="background-color: #e8f1fb; color: #295885; font-size: 12px; font-weight: 700; padding: 7px 14px; border-radius: 20px; display: inline-block; letter-spacing: 0.08em; text-transform: uppercase;">
        <%= primeiro_acesso ? "Primeiro acesso" : "Recuperacao de acesso" %>
      </span>
    </td>
  </tr>
</table>

<h1 style="margin: 0 0 16px; font-size: 30px; font-weight: 700; color: #2A3E52; line-height: 1.25;">
  Ola, <span style="color: #1468B8;"><%= nome_destinatario %></span>
</h1>

<p style="margin: 0 0 18px; font-size: 16px; line-height: 1.7; color: #295885;">
  <% if primeiro_acesso %>
    Sua conta na <strong style="color: #2A3E52;"><%= app_nome %></strong> foi criada com sucesso. Para acessar o sistema pela primeira vez, defina sua senha no botao abaixo.
  <% else %>
    Recebemos uma solicitacao para redefinir a senha da sua conta na <strong style="color: #2A3E52;"><%= app_nome %></strong>.
  <% end %>
</p>

<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin: 28px 0;">
  <tr>
    <td style="background: linear-gradient(180deg, #f8fbff 0%, #eef3f8 100%); border-radius: 18px; padding: 22px; border-left: 4px solid #1468B8; border-top: 1px solid #d6e0eb; border-right: 1px solid #d6e0eb; border-bottom: 1px solid #d6e0eb;">
      <p style="margin: 0 0 10px; font-size: 15px; line-height: 1.6; font-weight: 700; color: #2A3E52;">
        Como continuar
      </p>
      <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #295885;">
        <%= primeiro_acesso ? "Para criar sua senha e concluir o primeiro acesso, use o botao abaixo." : "Para escolher uma nova senha e voltar ao sistema, use o botao abaixo." %>
        Por seguranca, este link expira em <strong><%= prazo_texto %></strong>.
      </p>
    </td>
  </tr>
</table>

<div style="text-align: center; margin: 32px 0;">
  <a href="<%= recuperar_senha_url %>" style="display: inline-block; padding: 16px 36px; background: linear-gradient(135deg, #1468B8 0%, #295885 100%); color: #ffffff !important; text-decoration: none; font-size: 16px; font-weight: 700; border-radius: 14px; box-shadow: 0 12px 28px rgba(20, 104, 184, 0.22);">
    <%= primeiro_acesso ? "Definir minha senha" : "Redefinir minha senha" %>
  </a>
</div>

<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 24px;">
  <tr>
    <td style="padding: 18px 20px; background-color: #fef4ea; border: 1px solid #f3d2ae; border-radius: 16px;">
      <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #9a5a18;">
        <%= primeiro_acesso ? "Se voce nao reconhece este cadastro, ignore este e-mail e avise o administrador responsavel." : "Se voce nao fez esta solicitacao, ignore este e-mail. Sua senha atual continuara funcionando ate que uma nova seja cadastrada." %>
      </p>
    </td>
  </tr>
</table>

<p style="margin: 0 0 8px; font-size: 13px; line-height: 1.7; color: #6b7f93;">
  Se o botao nao funcionar, copie e cole este endereco no navegador:
</p>
<p style="margin: 0; font-size: 13px; line-height: 1.7; word-break: break-all;">
  <a href="<%= recuperar_senha_url %>" style="color: #1468B8; text-decoration: underline;"><%= recuperar_senha_url %></a>
</p>
